{
  "api_url": "http://api:8000",
  "media_types": {
    "image": {
      "model_endpoints": {
        "npr_deepfakedetection": "http://npr_deepfakedetection:5001/predict",
        "yermandy_clip_detection": "http://yermandy_clip_detection:5002/predict",
        "wavelet_clip_detection": "http://wavelet_clip_detection:5003/predict",
        "universalfakedetect": "http://universalfakedetect:5004/predict",
        "spsl_deepfake_detection": "http://spsl_deepfake_detection:5006/predict",
        "ucf_deepfake_detection": "http://ucf_deepfake_detection:5007/predict"
      },
      "health_endpoints": {
        "npr_deepfakedetection": "http://npr_deepfakedetection:5001/health",
        "yermandy_clip_detection": "http://yermandy_clip_detection:5002/health",
        "wavelet_clip_detection": "http://wavelet_clip_detection:5003/health",
        "universalfakedetect": "http://universalfakedetect:5004/health",
        "spsl_deepfake_detection": "http://spsl_deepfake_detection:5006/health",
        "ucf_deepfake_detection": "http://ucf_deepfake_detection:5007/health"
      },
      "supported_extensions": [
        "*.jpg",
        "*.jpeg",
        "*.png",
        "*.webp",
        "*.bmp",
        "*.gif",
        "*.tiff",
        "*.tif",
        "*.avif"
      ]
    },
    "video": {
      "model_endpoints": {
        "cross_efficient_vit": "http://video-detect:7001/predict"
      },
      "health_endpoints": {
        "cross_efficient_vit": "http://video-detect:7001/health"
      },
      "supported_extensions": [
        "*.mp4",
        "*.avi",
        "*.mov",
        "*.mkv"
      ]
    },
    "audio": {
      "model_endpoints": {
        "vocoder_artifacts": "http://vocoder_artifacts:7002/predict",
        "rawgat_st": "http://rawgat_st:7005/predict",
        "wavlm": "http://wavlm:7006/predict"
      },
      "health_endpoints": {
        "vocoder_artifacts": "http://vocoder_artifacts:7002/health",
        "rawgat_st": "http://rawgat_st:7005/health",
        "wavlm": "http://wavlm:7006/health"
      },
      "supported_extensions": [
        "*.mp3",
        "*.wav",
        "*.flac",
        "*.aac",
        "*.ogg"
      ]
    }
  },
  "default_output_dir_base": "./deepsafe_test_results",
  "default_threshold": 0.6,
  "default_ensemble_method": "average",
  "default_api_timeout_seconds": 1200,
  "default_model_timeout_seconds_video": 1800,
  "memory_optimization": true,
  "default_max_workers_batch": 1
}